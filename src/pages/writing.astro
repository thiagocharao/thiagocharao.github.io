---
import BaseLayout from '../layouts/BaseLayout.astro';

// Fetch articles from DOIS RSS feed
interface Article {
  title: string;
  description: string;
  date: string;
  category: string;
  link: string;
}

let articles: Article[] = [];

try {
  const response = await fetch('https://dois.one/rss.xml?author=thiago');
  const xml = await response.text();
  
  // Parse RSS items
  const itemRegex = /<item>([\s\S]*?)<\/item>/g;
  const items = xml.matchAll(itemRegex);
  
  for (const match of items) {
    const item = match[1];
    const title = item.match(/<title><!\[CDATA\[(.*?)\]\]><\/title>|<title>(.*?)<\/title>/)?.[1] || item.match(/<title>(.*?)<\/title>/)?.[1] || '';
    const description = item.match(/<description><!\[CDATA\[(.*?)\]\]><\/description>|<description>(.*?)<\/description>/)?.[1] || item.match(/<description>(.*?)<\/description>/)?.[1] || '';
    const link = item.match(/<link>(.*?)<\/link>/)?.[1] || '';
    const pubDate = item.match(/<pubDate>(.*?)<\/pubDate>/)?.[1] || '';
    const category = item.match(/<category>(.*?)<\/category>/)?.[1] || 'article';
    
    articles.push({
      title: title.trim(),
      description: description.trim(),
      date: pubDate ? new Date(pubDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : '',
      category: category.trim(),
      link: link.trim(),
    });
  }
} catch (error) {
  console.error('Failed to fetch DOIS RSS feed:', error);
}
---

<BaseLayout title="Writing" description="Articles, notes, and opinions by Thiago Charão">
  <section class="py-20">
    <div class="max-w-4xl mx-auto px-6">
      <div class="mb-12">
        <h1 class="text-3xl lg:text-4xl font-bold tracking-tight text-gray-900 dark:text-white mb-4">
          Writing
        </h1>
        <p class="text-lg text-gray-600 dark:text-gray-400">
          Articles, notes, and opinions on engineering, AI, and building software. 
          Published on <a href="https://dois.one" target="_blank" rel="noopener" class="font-sora font-bold text-blue-600 dark:text-accent hover:underline">DOIS</a>.
        </p>
      </div>

      <!-- Articles list -->
      {articles.length > 0 ? (
        <div class="space-y-1">
          {articles.map((article) => (
            <a 
              href={article.link}
              target="_blank"
              rel="noopener"
              class="block py-5 border-b border-gray-200 dark:border-gray-800 group"
            >
              <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-2">
                <div>
                  <h2 class="text-lg font-medium text-gray-900 dark:text-white group-hover:text-accent transition-colors inline-flex items-center gap-2">
                    {article.title}
                    <svg class="w-3.5 h-3.5 text-gray-400 group-hover:text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M7 17L17 7M17 7H7M17 7V17"/>
                    </svg>
                  </h2>
                  <p class="text-gray-500 dark:text-gray-400 mt-1">
                    {article.description}
                  </p>
                </div>
                <div class="flex items-center gap-3 text-sm text-gray-400 dark:text-gray-500 whitespace-nowrap">
                  <span class="font-sora text-xs">DOIS</span>
                  <span>·</span>
                  <span>{article.date}</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="text-gray-500 dark:text-gray-400 py-8 text-center">
          Articles coming soon. Check out <a href="https://dois.one" target="_blank" rel="noopener" class="font-sora font-bold text-blue-600 dark:text-accent hover:underline">DOIS</a> in the meantime.
        </p>
      )}

      <!-- About DOIS -->
      <div class="mt-16 p-8 rounded-xl bg-gray-100 dark:bg-gray-800/50 border border-gray-200 dark:border-gray-700">
        <p class="text-lg text-gray-700 dark:text-gray-300 mb-4">
          <a href="https://dois.one" target="_blank" rel="noopener" class="font-sora font-bold text-blue-600 dark:text-accent hover:underline">DOIS</a> is 
          a project I run with Andreos where we share experiments and opinions on engineering and AI.
        </p>
        <a 
          href="https://dois.one" 
          target="_blank" 
          rel="noopener"
          class="inline-flex items-center gap-2 text-blue-600 dark:text-accent font-medium hover:underline"
        >
          Visit DOIS
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M7 17L17 7M17 7H7M17 7V17"/>
          </svg>
        </a>
      </div>

      <!-- LinkedIn callout -->
      <div class="mt-6 p-8 rounded-xl bg-gray-100 dark:bg-gray-800/50 border border-gray-200 dark:border-gray-700">
        <p class="text-lg text-gray-700 dark:text-gray-300 mb-4">
          I also post on <a href="https://linkedin.com/in/charao" target="_blank" rel="noopener" class="text-blue-600 dark:text-accent hover:underline font-medium">LinkedIn</a> — shorter takes on AI, engineering leadership, and what I'm working on.
        </p>
        <a 
          href="https://linkedin.com/in/charao" 
          target="_blank" 
          rel="noopener"
          class="inline-flex items-center gap-2 text-blue-600 dark:text-accent font-medium hover:underline"
        >
          Follow on LinkedIn
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M7 17L17 7M17 7H7M17 7V17"/>
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
