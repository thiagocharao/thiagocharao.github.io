---
import BaseLayout from '../layouts/BaseLayout.astro';

// Fetch articles from DOIS RSS feed
interface Article {
  title: string;
  description: string;
  date: string;
  category: string;
  link: string;
}

let articles: Article[] = [];

try {
  const response = await fetch('https://dois.one/rss.xml?author=thiago');
  const xml = await response.text();
  
  // Parse RSS items
  const itemRegex = /<item>([\s\S]*?)<\/item>/g;
  const items = xml.matchAll(itemRegex);
  
  // Helper to decode HTML entities
  function decodeHtmlEntities(text: string): string {
    return text
      .replace(/&apos;/g, "'")
      .replace(/&quot;/g, '"')
      .replace(/&amp;/g, '&')
      .replace(/&lt;/g, '<')
      .replace(/&gt;/g, '>')
      .replace(/&#(\d+);/g, (_, code) => String.fromCharCode(parseInt(code, 10)));
  }

  for (const match of items) {
    const item = match[1];
    const title = item.match(/<title><!\[CDATA\[(.*?)\]\]><\/title>|<title>(.*?)<\/title>/)?.[1] || item.match(/<title>(.*?)<\/title>/)?.[1] || '';
    const description = item.match(/<description><!\[CDATA\[(.*?)\]\]><\/description>|<description>(.*?)<\/description>/)?.[1] || item.match(/<description>(.*?)<\/description>/)?.[1] || '';
    const link = item.match(/<link>(.*?)<\/link>/)?.[1] || '';
    const pubDate = item.match(/<pubDate>(.*?)<\/pubDate>/)?.[1] || '';
    const category = item.match(/<category>(.*?)<\/category>/)?.[1] || 'article';
    
    articles.push({
      title: decodeHtmlEntities(title.trim()),
      description: decodeHtmlEntities(description.trim()),
      date: pubDate ? new Date(pubDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : '',
      category: category.trim(),
      link: link.trim(),
    });
  }
} catch (error) {
  console.error('Failed to fetch DOIS RSS feed:', error);
}
---

<BaseLayout title="Writing" description="Articles, notes, and opinions by Thiago Charão">
  <section class="py-12 md:py-16">
    <div class="max-w-4xl mx-auto px-6">
      <div class="mb-10">
        <h1 class="text-3xl lg:text-4xl font-bold tracking-tight text-gray-900 dark:text-white mb-4">
          Writing
        </h1>
        <p class="text-lg text-gray-600 dark:text-gray-300">
          Articles, notes, and opinions on engineering, AI, and building software. 
          Published on <a href="https://dois.one" target="_blank" rel="noopener" class="font-sora font-bold text-blue-600 dark:text-accent hover:underline">DOIS</a>.
        </p>
      </div>

      <!-- Articles list -->
      {articles.length > 0 ? (
        <div class="space-y-2">
          {articles.map((article) => (
            <a 
              href={article.link}
              target="_blank"
              rel="noopener"
              class="block p-5 rounded-xl bg-gray-50 dark:bg-gray-800/60 border border-gray-200 dark:border-gray-700 hover:border-blue-400 dark:hover:border-accent transition-all group"
            >
              <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3">
                <div class="flex-1">
                  <h2 class="text-lg font-semibold text-gray-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-accent transition-colors inline-flex items-center gap-2">
                    {article.title}
                    <svg class="w-3.5 h-3.5 opacity-0 group-hover:opacity-100 transition-opacity text-blue-600 dark:text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M7 17L17 7M17 7H7M17 7V17"/>
                    </svg>
                  </h2>
                  <p class="text-gray-600 dark:text-gray-400 mt-1.5 leading-relaxed">
                    {article.description}
                  </p>
                </div>
                <div class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-500 whitespace-nowrap">
                  <span class="font-sora text-xs font-bold text-blue-600 dark:text-accent">DOIS</span>
                  <span class="text-gray-300 dark:text-gray-600">·</span>
                  <span>{article.date}</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="py-12 text-center">
          <p class="text-gray-500 dark:text-gray-400">
            Articles coming soon. Check out <a href="https://dois.one" target="_blank" rel="noopener" class="font-sora font-bold text-blue-600 dark:text-accent hover:underline">DOIS</a> in the meantime.
          </p>
        </div>
      )}

      <!-- Elsewhere section - subtle, doesn't compete -->
      <div class="mt-16 pt-8 border-t border-gray-200 dark:border-gray-700">
        <p class="text-sm text-gray-500 dark:text-gray-500 mb-4">Also find me on</p>
        <div class="flex flex-wrap gap-4">
          <a 
            href="https://dois.one" 
            target="_blank" 
            rel="noopener"
            class="inline-flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-accent transition-colors"
          >
            <span class="font-sora font-bold">DOIS</span>
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M7 17L17 7M17 7H7M17 7V17"/>
            </svg>
          </a>
          <a 
            href="https://linkedin.com/in/charao" 
            target="_blank" 
            rel="noopener"
            class="inline-flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-accent transition-colors"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
            LinkedIn
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M7 17L17 7M17 7H7M17 7V17"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
